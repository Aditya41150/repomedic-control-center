# RepoMedic → TrueForge harness (server-side only; never exposed to the browser).
# Copy to `.env` and fill in with your LOCAL harness values. No secrets belong in this file.

# Base URL of the locally running TrueForge harness.
TRUEFORGE_BASE_URL=http://127.0.0.1:8790

# Model name configured in your TrueForge provider setup (e.g. a Gemini model id).
TRUEFORGE_MODEL=<configured Gemini model>

# Name of the GitHub MCP server as registered inside TrueForge.
TRUEFORGE_GITHUB_MCP_SERVER=github

# Repository the first read-only investigation slice targets.
TRUEFORGE_REPOSITORY=Aditya41150/repomedic

# Only required when TrueForge runs with OIDC auth enabled. Leave empty for local mode.
TRUEFORGE_API_TOKEN=

# Optional conservative live-investigation budgets (server-side only).
TRUEFORGE_MAX_TOOL_CALLS=12
TRUEFORGE_MAX_SEARCH_CODE_CALLS=3

# Optional: default UI mode on first load ("demo" or "trueforge").
VITE_REPOMEDIC_MODE=demo
